<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KarinderyaPos" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFDAD5</item>
        <item name="colorOnPrimaryContainer">#410001</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSecondaryContainer">#FFE08C</item>
        <item name="colorOnSecondaryContainer">#261A00</item>
        <item name="android:colorBackground">@color/brand_surface</item>
        <item name="colorSurface">@color/brand_surface</item>
    </style>

    <style name="Widget.KarinderyaPos.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="subtitleTextColor">?attr/colorOnPrimary</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
        <item name="android:theme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <style name="TextAppearance.KarinderyaPos.Money" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.KarinderyaPos.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>
</resources>
