<?xml version="1.0" encoding="utf-8"?>
<!-- Local DB holds password hashes and sales; keep it out of cloud backup / device transfer.
     Use the in-app JSON export to move menu and orders between devices. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
